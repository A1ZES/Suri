{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suri",
  "version": "0.1.0",
  "identifier": "io.github.a1zes.suri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Suri",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5OTNEQUY0OEIyRkNDMDEKUldRQnpDK0w5TnFUeVVwZ2xYWm5IQmFoL0dHSDhIUUJPb0JRMlYvZFp4ODZoMTk0QVFZQUVWMlIK",
      "endpoints": ["https://github.com/A1ZES/Suri/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
